# CodeSync Server Environment Configuration

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=24h

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Email Service (Nodemailer for OTP & Password Reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Code Execution Service (Judge0 RapidAPI or fallback to Piston)
JUDGE0_API_KEY=YOUR_RAPIDAPI_KEY_OPTIONAL
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
